{"schema": "mulusa.section/1", "nodes": [{"id": "e114", "type": "section", "props": {"role": "about"}, "style": {}, "children": [{"id": "e113", "type": "columns", "props": {"columns": "6fr 5fr", "width": "content"}, "style": {"gap": "80px", "align_items": "center"}, "responsive": {"tablet": {"props": {"columns": 1}}}, "children": [{"id": "e111", "type": "container", "props": {}, "style": {"gap": "16px"}, "children": [{"id": "e108", "type": "heading", "props": {"text": "Songs written late, played loud", "level": 2}, "style": {}}, {"id": "e109", "type": "text", "props": {"text": "What began in a borrowed room has become a life on the road: three records, hundreds of shows and a sound that keeps changing.", "muted": true}, "style": {}}, {"id": "e110", "type": "text", "props": {"text": "Every release is recorded live wherever possible and mixed with the people who were in the room. The new material is the most honest work yet.", "muted": true}, "style": {}}]}, {"id": "e112", "type": "image", "props": {"media": {"kind": "placeholder", "seed": "dj-producer-6", "subject": "vinyl", "ratio": 0.86, "label": "About image"}, "alt": "About image", "ratio": 0.86}, "style": {"border_radius": "$radius"}}]}]}], "source_template": "music/dj-producer"}