{"schema": "mulusa.section/1", "nodes": [{"id": "e123", "type": "section", "props": {"role": "about"}, "style": {}, "children": [{"id": "e122", "type": "container", "props": {"width": "content"}, "style": {}, "children": [{"id": "e117", "type": "container", "props": {}, "style": {"gap": "14px", "margin_bottom": "48px", "max_width": "760px"}, "children": [{"id": "e116", "type": "heading", "props": {"text": "Songs written late, played loud", "level": 2}, "style": {}}]}, {"id": "e120", "type": "columns", "props": {"columns": 2}, "style": {"gap": "48px"}, "children": [{"id": "e118", "type": "text", "props": {"text": "What began in a borrowed room has become a life on the road: three records, hundreds of shows and a sound that keeps changing.", "muted": true}, "style": {"font_size": "1.08rem"}}, {"id": "e119", "type": "text", "props": {"text": "Every release is recorded live wherever possible and mixed with the people who were in the room. The new material is the most honest work yet.", "muted": true}, "style": {"font_size": "1.08rem"}}]}, {"id": "e121", "type": "image", "props": {"media": {"kind": "placeholder", "seed": "music-magazine-12", "subject": "vinyl", "ratio": 2.6, "label": "About image"}, "alt": "About image", "ratio": 2.6}, "style": {"margin_top": "48px", "border_radius": "$radius"}}]}]}], "source_template": "music/music-magazine"}